rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /disputes/{disputeId} {
      allow read: if request.auth != null &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid);
      allow write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      // Extended to keep MVP environments functional.
      // TODO: replace with authenticated per-collection rules before production scale.
      allow read, write: if request.time < timestamp.date(2030, 12, 31) &&
        request.path.segments[3] != 'disputes';
    }
  }
}
